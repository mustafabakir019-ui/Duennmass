---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Dünnmass – Maßgeschneiderte Anzüge & Schützenfest-Mode"
    description="Dünnmass steht für maßgeschneiderte Anzüge, hochwertige Herrenmode und individuelle Schützenfest-Outfits."
>

    <section class="hero">
        <div class="hero-inner">

            <div class="hero-content">

                <div class="eyebrow">
                    Maßanfertigung aus Leidenschaft
                </div>

                <h1>
                    Kleidung,<br />
                    die zu Ihnen passt.
                </h1>

                <p>
                    Entdecken Sie individuelle Maßanfertigungen,
                    hochwertige Anzüge und traditionelle
                    Schützenfest-Mode – persönlich und mit Liebe
                    zum Detail gefertigt.
                </p>

                <div class="hero-actions">
                    <a href="/anzuege/" class="button-primary">
                        Anzüge entdecken
                    </a>

                    <a href="/schuetzenfest/" class="button-secondary">
                        Schützenfest entdecken
                    </a>
                </div>

            </div>

        </div>
    </section>


    <section class="section">

        <div class="section-inner">

            <div class="section-heading center">

                <div class="eyebrow">
                    Unsere Bereiche
                </div>

                <h2>
                    Zwei Welten.<br />
                    Ein Anspruch.
                </h2>

                <p>
                    Ob eleganter Maßanzug für den Beruf,
                    eine besondere Hochzeit oder das nächste
                    Schützenfest – bei uns steht die individuelle
                    Passform im Mittelpunkt.
                </p>

            </div>


            <div class="category-grid">

                <a href="/anzuege/" class="category-card">

                    <span>
                        Maßanzüge
                    </span>

                    <h3>
                        Anzüge
                    </h3>

                    <p>
                        Business, Hochzeit, Casual und
                        individuelle Maßanfertigungen.
                    </p>

                </a>


                <a href="/schuetzenfest/" class="category-card">

                    <span>
                        Tradition & Stil
                    </span>

                    <h3>
                        Schützenfest
                    </h3>

                    <p>
                        Schützenfest-Anzüge, passende Mützen
                        und komplette Outfits.
                    </p>

                </a>

            </div>

        </div>

    </section>


    <section class="split-section">

        <div class="split-image split-image--atelier">
            Atelier
        </div>

        <div class="split-content">

            <div class="eyebrow">
                Persönlich. Individuell.
            </div>

            <h2>
                Maß statt<br />
                von der Stange.
            </h2>

            <p>
                Ein guter Anzug soll nicht nur gut aussehen.
                Er soll sitzen, sich richtig anfühlen und
                zu dem Menschen passen, der ihn trägt.
            </p>

            <a href="/kontakt/" class="button-secondary">
                Kontakt aufnehmen
            </a>

        </div>

    </section>

</Layout>