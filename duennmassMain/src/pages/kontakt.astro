---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Kontakt | Dünnmass"
    description="Kontaktieren Sie Dünnmass für Fragen zu Maßanzügen, Schützenfest-Outfits und individueller Maßanfertigung."
>

    <section class="page-header page-header--kontakt">

        <div class="page-header-inner">

            <div class="eyebrow">
                Wir sind für Sie da
            </div>

            <h1>
                Kontakt
            </h1>

            <p>
                Sie haben Fragen zu einem Anzug, einem
                Schützenfest-Outfit oder einer individuellen
                Maßanfertigung? Sprechen Sie uns direkt an.
            </p>

        </div>

    </section>


    <section class="section section--contact">

        <div class="section-inner">

            <div class="category-grid">

                <div class="category-card">

                    <span>
                        Telefon
                    </span>

                    <h3>
                        Telefonnummer
                    </h3>

                    <p>
                        Rufen Sie uns direkt an und sprechen
                        Sie persönlich mit uns.
                    </p>

                    <a
                        href="tel:TELEFONNUMMER"
                        class="button-secondary"
                        style="margin-top: 25px; align-self: flex-start;"
                    >
                        Jetzt anrufen
                    </a>

                </div>


                <div class="category-card">

                    <span>
                        Vor Ort
                    </span>

                    <h3>
                        Besuchen Sie uns
                    </h3>

                    <p>
                        Sie können auch ohne Termin bei uns
                        vorbeikommen.
                    </p>

                </div>

            </div>

        </div>

    </section>

</Layout>