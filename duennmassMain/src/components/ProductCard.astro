---
interface Props {
    category: string;
    title: string;
    material: string;
    price: string;
    colors: string[];
    image?: string;
    featured?: boolean;
    description?: string;
    details?: string[];
}

const {
    category,
    title,
    material,
    price,
    colors,
    image,
    featured = false,
    description = "Individuell auf Ihren Stil abgestimmt – mit hochwertiger Verarbeitung, einem modernen Schnitt und persönlicher Beratung.",
    details = [
        "Individuell auf Ihren Stil angepasst",
        "Hochwertige Materialien und Verarbeitung",
        "Persönliche Beratung inklusive"
    ]
} = Astro.props;

const productData = encodeURIComponent(JSON.stringify({
    category,
    title,
    material,
    price,
    colors,
    image: image || "",
    description,
    details
}));
---

<article
    class:list={{
        "product-card": true,
        "product-card-featured": featured
    }}
    data-category={category.toLowerCase()}
>

    <button
        type="button"
        class="product-card-button"
        data-open-product
        data-product={productData}
        aria-label={`Produktdetails für ${title} öffnen`}
    >
        <div class="product-image">
            {image ? (
                <img
                    src={image}
                    alt={`${title} – Maßanzug von Dünnmass`}
                    loading="lazy"
                />
            ) : (
                <div class="image-placeholder">
                    <span>Foto folgt</span>
                </div>
            )}

            <span class="product-tag">
                {category}
            </span>

            <span class="image-overlay">
                Details ansehen
                <span>→</span>
            </span>
        </div>
    </button>

    <div class="product-content">

        <h2>{title}</h2>

        <div class="product-meta">
            <span>{material}</span>
            <span>{price}</span>
        </div>

        <div class="swatches" aria-label="Verfügbare Farben">
            {colors.map((color) => (
                <span
                    class="swatch"
                    style={`background:${color}`}
                ></span>
            ))}
        </div>

        <button
            type="button"
            class="product-link"
            data-open-product
            data-product={productData}
            aria-label={`Details zu ${title} anzeigen`}
        >
            Details ansehen
            <span>→</span>
        </button>

    </div>

</article>